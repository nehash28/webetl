# Copy this file to .env and fill in what you use. Never commit .env.
# docker compose reads it automatically; leave a value empty to turn that channel off.

# Email alerts. Gmail: SMTP_HOST=smtp.gmail.com and a 16-letter App password (no spaces)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Slack alerts (optional)
SLACK_WEBHOOK_URL=

# Optional source keys
COINGECKO_API_KEY=
GITHUB_TOKEN=

# Cloud warehouse (optional). Leave empty to use the local Postgres container.
# For a public dashboard: paste your Neon connection string here, e.g.
# WAREHOUSE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
WAREHOUSE_URL=
